{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "mf-admin": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "customWebpackConfig": {
              "path": "extra-webpack.config.js",
              "libraryTarget": "system"
            },
            "outputPath": "../dist/admin",
            "index": "",
            "main": "src/main.single-spa.ts",
            "tsConfig": "tsconfig.app.json",
            "outputHashing": "none",
            "styles": [
              "src/styles.css"
            ],
            "assets": [],
            "optimization": true,
            "sourceMap": false
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "watch": false,
            "buildTarget": "mf-admin:build-pruebas",
            "runnerConfig": "vitest.config.ts",
            "coverage": true,
            "coverageInclude": ["src/app/servicios/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts"],
            "coverageThresholds": { "lines": 80 }
          }
        },
        "build-pruebas": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "externalDependencies": ["@agro/compartido"],
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    }
  }
}
